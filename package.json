{
  "name": "executive-diagnosis-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "overrides": { "miniflare": { "undici": "7.30.1" } },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "node scripts/verify-release-config.mjs",
    "deploy": "vite build && wrangler deploy",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build && npm run verify:build",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:headers": "node scripts/check-local-headers.mjs",
    "preview:worker": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "healthcheck": "node scripts/check-health.mjs",
    "verify:baseline": "node scripts/verify-production-baseline.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
